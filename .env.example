# Copie ce fichier en « .env » et remplis-le.
# --- Moteurs (tes clés d'éditeur, utilisées pour tous les clients) ---
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxx            # optionnel : transcription plus rapide

# --- Application ---
SECRET_KEY=change-moi-par-une-longue-chaine-aleatoire
ADMIN_EMAILS=ton.email@exemple.fr       # accès illimité, sans abonnement

# --- Paiement Stripe (optionnel tant que tu testes) ---
# STRIPE_SECRET_KEY=sk_live_xxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# E-mails (mot de passe oublié, bienvenue, veille prête) — https://resend.com
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_EXPEDITEUR=Virallink <contact@virallink.fr>
# URL_PUBLIQUE=https://ton-domaine.fr      # adresse du site, pour les liens des e-mails

# Banque d'images et de vidéos libres de droits du studio (gratuite) — clé sur https://pixabay.com/api/docs/ une fois connecté
# PIXABAY_API_KEY=xxxxxxxx
# (ou, si tu en as une : PEXELS_API_KEY=xxxxxxxx)

# Boutique en lien dans la bio : commission prélevée sur chaque vente des clientes (en %, 0 par défaut).
# Nécessite Stripe Connect activé sur le compte Stripe (tableau de bord Stripe → Connect).
BOUTIQUE_COMMISSION=0
